SECRET_KEY=change-me

# Django debug mode — defaults to true when unset (local dev). Deployments
# MUST set DEBUG=false explicitly. With DEBUG=false, SECRET_KEY above must
# also be set to a real value — startup refuses to run with the insecure
# dev fallback in that mode.
DEBUG=true

# Comma-separated list of hostnames Django will serve (Django's Host header
# check). Required once DEBUG=false — leave blank in dev (DEBUG=true serves
# any host). e.g. ALLOWED_HOSTS=takulife.kr,www.takulife.kr
# Do NOT use "*" — it disables the Host-header check entirely.
ALLOWED_HOSTS=

# Comma-separated list of scheme+host origins trusted for unsafe (POST/PUT/
# etc.) requests behind HTTPS — Django's CSRF check requires the Origin
# header to match one of these when the request is HTTPS. e.g.
# CSRF_TRUSTED_ORIGINS=https://takulife.kr,https://www.takulife.kr
# Each entry MUST include the https:// scheme — a bare hostname never matches.
CSRF_TRUSTED_ORIGINS=

# Database — leave blank to keep using the local sqlite file (db.sqlite3).
# Set this to point at Postgres instead, e.g. after `docker compose up -d db`:
# DATABASE_URL=postgresql://taku:taku@localhost:5432/taku
# Add ?sslmode=require for managed Postgres over TLS (e.g. Render):
# DATABASE_URL=postgresql://taku:taku@host:5432/taku?sslmode=require
DATABASE_URL=

# Email (SMTP) — leave EMAIL_HOST blank to use the console backend locally
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=no-reply@takulife.example

# Contact address shown on the legal pages / footer for user inquiries and
# data-rights requests. Set to a real, monitored inbox before launch.
SUPPORT_EMAIL=support@takulife.example

# Secure cookies — set to 1/true in production (HTTPS) so the session and CSRF
# cookies are only sent over TLS. Leave blank for local http development.
SECURE_COOKIES=

# Set to 1/true in production when running behind a TLS-terminating reverse
# proxy (PaaS router). Enables SECURE_PROXY_SSL_HEADER (trusts
# X-Forwarded-Proto), SECURE_SSL_REDIRECT (http->https redirect), and HSTS.
# Independent of SECURE_COOKIES above — leave blank for local http
# development.
# WARNING: only enable this when the reverse proxy in front of the app is
# guaranteed to set (and strip any client-supplied) X-Forwarded-Proto —
# trusting it on a directly internet-exposed host lets a client spoof the
# header and bypass the HTTPS checks. In a normal production deployment,
# set SECURE_SSL and SECURE_COOKIES to true together.
SECURE_SSL=

# Google OAuth (social login). Register an OAuth 2.0 Client ID in the Google
# Cloud Console, add the redirect URI /accounts/google/login/callback/ (use the
# localhost URL for dev and your real host for prod), then paste the credentials
# below. Blank leaves the "Google로 계속하기" button visible but non-functional.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Anthropic API key (core/llm client adapter). Blank raises
# LLMConfigurationError on first LLM call — draft extraction callers must
# fall back to the existing heuristic when this is unset.
ANTHROPIC_API_KEY=

# Deployment note (no env var yet): behind a reverse proxy, configure
# AXES_IPWARE_* in settings so django-axes locks out the real client IP rather
# than the proxy IP. Otherwise one attacker's failures can lock out everyone.

# Media object storage (S3-compatible — Cloudflare R2, Backblaze B2, etc).
# Leave MEDIA_STORAGE_BUCKET blank to keep local-disk storage (MEDIA_ROOT) —
# fine for local dev, but PaaS filesystems are ephemeral, so a production
# deployment on PaaS must set all five. Example values for Cloudflare R2:
# MEDIA_STORAGE_BUCKET=takulife-media
# MEDIA_STORAGE_ACCESS_KEY_ID=<R2 access key id>
# MEDIA_STORAGE_SECRET_ACCESS_KEY=<R2 secret access key>
# MEDIA_STORAGE_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# MEDIA_STORAGE_REGION=auto
MEDIA_STORAGE_BUCKET=
MEDIA_STORAGE_ACCESS_KEY_ID=
MEDIA_STORAGE_SECRET_ACCESS_KEY=
MEDIA_STORAGE_ENDPOINT_URL=
MEDIA_STORAGE_REGION=
