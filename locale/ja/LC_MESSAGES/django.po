#: accounts/forms.py
#, python-brace-format
msgid "<a href=\"{terms}\" target=\"_blank\" rel=\"noopener\">이용약관</a> 및 <a href=\"{privacy}\" target=\"_blank\" rel=\"noopener\">개인정보처리방침</a>에 동의합니다."
msgstr "<a href=\"{terms}\" target=\"_blank\" rel=\"noopener\">利用規約</a>および<a href=\"{privacy}\" target=\"_blank\" rel=\"noopener\">プライバシーポリシー</a>に同意します。"

#: accounts/forms.py templates/account/settings.html
#: templates/account/signup.html templates/core/mypage.html
#: templates/socialaccount/signup.html
msgid "닉네임"
msgstr "ニックネーム"

#: accounts/forms.py
msgid "닉네임을 입력해 주세요."
msgstr "ニックネームを入力してください。"

#: accounts/forms.py
msgid "이용약관 및 개인정보처리방침에 동의해야 가입할 수 있습니다."
msgstr "登録するには、利用規約とプライバシーポリシーへの同意が必要です。"

#: accounts/forms.py templates/account/email_change.html
#: templates/account/password_change.html
msgid "현재 비밀번호"
msgstr "現在のパスワード"

#: accounts/forms.py web/views/account.py
msgid "비밀번호가 올바르지 않습니다."
msgstr "パスワードが正しくありません。"

#: accounts/services.py
msgid "비밀번호를 여러 번 잘못 입력했습니다. 잠시 후 다시 시도해 주세요."
msgstr "パスワードを何度も間違えて入力しました。しばらくしてから再度お試しください。"

#: accounts/services.py
msgid "닉네임 변경이 너무 잦습니다. 잠시 후 다시 시도해 주세요."
msgstr "ニックネームの変更が多すぎます。しばらくしてから再度お試しください。"

#: accounts/services.py
msgid "이미 사용 중인 닉네임입니다."
msgstr "すでに使用されているニックネームです。"

#: accounts/services.py
msgid "변경 이력 없음"
msgstr "変更履歴なし"

#: accounts/validators.py
msgid "닉네임은 2자 이상 20자 이하로 입력해 주세요."
msgstr "ニックネームは2〜20文字で入力してください。"

#: accounts/validators.py
msgid "닉네임은 한글, 영문, 숫자, _(밑줄)만 사용할 수 있습니다."
msgstr "ニックネームにはハングル、英字、数字、_（アンダースコア）のみ使用できます。"

#: accounts/validators.py
msgid "이 닉네임은 사용할 수 없습니다."
msgstr "このニックネームは使用できません。"

#: archive/serializers.py
msgid "event 또는 personal_entry 중 정확히 하나를 지정해야 합니다."
msgstr "event または personal_entry のうち、ちょうど1つを指定する必要があります。"

#: archive/serializers.py
msgid "이 personal_entry는 이 작업의 대상이 될 수 없습니다."
msgstr "この personal_entry は、この操作の対象にできません。"

#: archive/serializers.py
msgid "상태를 지정해야 합니다."
msgstr "状態を指定する必要があります。"

#: archive/services.py
msgid "place 외의 kind로는 PersonalEntry를 생성할 수 없습니다."
msgstr "place 以外の kind では PersonalEntry を作成できません。"

#: archive/services.py
msgid "quantity는 0 이상이어야 합니다."
msgstr "quantity は0以上である必要があります。"

#: archive/services.py
msgid "tradeable_quantity는 0 이상이어야 합니다."
msgstr "tradeable_quantity は0以上である必要があります。"

#: archive/services.py
msgid "tradeable_quantity는 quantity 이하여야 합니다."
msgstr "tradeable_quantity は quantity 以下である必要があります。"

#: archive/services.py
msgid "visit_record는 요청한 사용자의 소유여야 합니다."
msgstr "visit_record はリクエストしたユーザー本人のものである必要があります。"

#: archive/services.py
msgid "visit_record는 아이템 소유자의 소유여야 합니다."
msgstr "visit_record はアイテムの所有者のものである必要があります。"

#: archive/services.py
msgid "visit_record가 설정된 경우 event는 visit_record.event와 일치해야 합니다."
msgstr "visit_record が設定されている場合、event は visit_record.event と一致している必要があります。"

#: archive/views.py
msgid "이미 방문 기록이 있는 항목은 이 상태로 등록할 수 없습니다."
msgstr "すでに訪問記録がある項目は、この状態で登録できません。"

#: archive/views.py
msgid "이미 방문 기록이 있는 항목은 이 상태로 되돌릴 수 없습니다."
msgstr "すでに訪問記録がある項目は、この状態に戻せません。"

