#, python-brace-format
msgid "<a href=\"{terms}\" target=\"_blank\" rel=\"noopener\">이용약관</a> 및 <a href=\"{privacy}\" target=\"_blank\" rel=\"noopener\">개인정보처리방침</a>에 동의합니다."
msgstr "我同意<a href=\"{terms}\" target=\"_blank\" rel=\"noopener\">服务条款</a>和<a href=\"{privacy}\" target=\"_blank\" rel=\"noopener\">隐私政策</a>。"

#: accounts/forms.py templates/account/settings.html
#: templates/account/signup.html templates/core/mypage.html
#: templates/socialaccount/signup.html
msgid "닉네임"
msgstr "昵称"

#: accounts/forms.py
msgid "닉네임을 입력해 주세요."
msgstr "请输入昵称。"

#: accounts/forms.py
msgid "이용약관 및 개인정보처리방침에 동의해야 가입할 수 있습니다."
msgstr "必须同意服务条款和隐私政策才能注册。"

#: accounts/forms.py templates/account/email_change.html
#: templates/account/password_change.html
msgid "현재 비밀번호"
msgstr "当前密码"

#: accounts/forms.py web/views/account.py
msgid "비밀번호가 올바르지 않습니다."
msgstr "密码不正确。"

#: accounts/services.py
msgid "비밀번호를 여러 번 잘못 입력했습니다. 잠시 후 다시 시도해 주세요."
msgstr "密码多次输入错误，请稍后再试。"

#: accounts/services.py
msgid "닉네임 변경이 너무 잦습니다. 잠시 후 다시 시도해 주세요."
msgstr "修改昵称过于频繁，请稍后再试。"

#: accounts/services.py
msgid "이미 사용 중인 닉네임입니다."
msgstr "该昵称已被使用。"

#: accounts/services.py
msgid "변경 이력 없음"
msgstr "无变更记录"

#: accounts/validators.py
msgid "닉네임은 2자 이상 20자 이하로 입력해 주세요."
msgstr "昵称长度需为2到20个字符。"

#: accounts/validators.py
msgid "닉네임은 한글, 영문, 숫자, _(밑줄)만 사용할 수 있습니다."
msgstr "昵称只能使用韩文、英文、数字和下划线（_）。"

#: accounts/validators.py
msgid "이 닉네임은 사용할 수 없습니다."
msgstr "该昵称无法使用。"

#: archive/serializers.py
msgid "event 또는 personal_entry 중 정확히 하나를 지정해야 합니다."
msgstr "必须且仅能指定 event 或 personal_entry 中的一个。"

#: archive/serializers.py
msgid "이 personal_entry는 이 작업의 대상이 될 수 없습니다."
msgstr "此 personal_entry 不能作为该操作的对象。"

#: archive/serializers.py
msgid "상태를 지정해야 합니다."
msgstr "必须指定状态。"

#: archive/services.py
msgid "place 외의 kind로는 PersonalEntry를 생성할 수 없습니다."
msgstr "除 place 之外的 kind 无法创建 PersonalEntry。"

#: archive/services.py
msgid "quantity는 0 이상이어야 합니다."
msgstr "quantity 必须大于或等于 0。"

#: archive/services.py
msgid "tradeable_quantity는 0 이상이어야 합니다."
msgstr "tradeable_quantity 必须大于或等于 0。"

#: archive/services.py
msgid "tradeable_quantity는 quantity 이하여야 합니다."
msgstr "tradeable_quantity 必须小于或等于 quantity。"

#: archive/services.py
msgid "visit_record는 요청한 사용자의 소유여야 합니다."
msgstr "visit_record 必须属于发起请求的用户。"

#: archive/services.py
msgid "visit_record는 아이템 소유자의 소유여야 합니다."
msgstr "visit_record 必须属于该项目的所有者。"

#: archive/services.py
msgid "visit_record가 설정된 경우 event는 visit_record.event와 일치해야 합니다."
msgstr "设置了 visit_record 时，event 必须与 visit_record.event 一致。"

#: archive/views.py
msgid "이미 방문 기록이 있는 항목은 이 상태로 등록할 수 없습니다."
msgstr "已有到访记录的项目无法登记为此状态。"

#: archive/views.py
msgid "이미 방문 기록이 있는 항목은 이 상태로 되돌릴 수 없습니다."
msgstr "已有到访记录的项目无法恢复为此状态。"

